{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/ping.js", "use": "@vercel/node" },
    { "src": "api/csrf-token.js", "use": "@vercel/node" },
    { "src": "api/version.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/ping", "dest": "/api/ping.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/csrf-token", "dest": "/api/csrf-token.js" },
    { "src": "/version", "dest": "/api/version.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/login", "dest": "/public/login.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
